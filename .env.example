# TradeDesk environment variables

# Server
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Optional market-data switch. The app runs with the built-in simulator without this.
YAHOO_FINANCE_ENABLED="false"

# Client
VITE_API_URL="http://localhost:3001/api"
VITE_WS_URL="ws://localhost:3001"
VITE_GEMINI_API_KEY="your-gemini-api-key-here"

# Common deployment aliases for Next.js-based hosts or future migrations.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
GEMINI_API_KEY="your-gemini-api-key-here"
